# Copy to .env for local development. In production these are set in the
# Render dashboard (see render.yaml).

# Neon Postgres. Use the *pooled* connection string and keep sslmode=require.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Anthropic API key for the Panchangam Assistant chat (server/chat.ts).
# Without it the chat endpoint returns a "temporarily unavailable" message and
# the rest of the app works normally.
ANTHROPIC_API_KEY=sk-ant-...

# Web push (server/push-service.ts). These MUST be the same values the app has
# always used — new keys invalidate every existing subscription silently.
# To generate a fresh pair for a new environment: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:panchangam@mytelugupanchangam.space

# Optional: port to listen on (defaults to 5000; Render injects its own).
# PORT=5000
